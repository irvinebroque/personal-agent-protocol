{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MOLE private-access extension version 1",
    "description": "Declaration of public read-only resources. Origin equality, path semantics, and read-only behavior also require implementation checks.",
    "type": "object",
    "required": ["version", "moderator_config_uri", "resources"],
    "properties": {
        "version": {
            "const": "1"
        },
        "moderator_config_uri": {
            "$ref": "#/$defs/resource_url"
        },
        "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["url", "methods"],
                "properties": {
                    "url": {
                        "$ref": "#/$defs/resource_url"
                    },
                    "methods": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "enum": ["GET", "HEAD", "POST"]
                        }
                    },
                    "subpaths": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "if": {
                    "required": ["subpaths"],
                    "properties": {
                        "subpaths": {
                            "const": true
                        }
                    }
                },
                "then": {
                    "properties": {
                        "url": {
                            "pattern": "/$"
                        }
                    }
                }
            }
        }
    },
    "$defs": {
        "resource_url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^\\s/?#@\\\\]+/[^\\s?#\\\\]*$",
            "not": {
                "pattern": "%2[fF]|%5[cC]|/(?:\\.|%2[eE]){1,2}(?:/|$)"
            }
        }
    }
}
